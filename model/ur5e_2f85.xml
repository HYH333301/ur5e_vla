<mujoco model="ur5e_2f85">
  <!--
    UR5e + Robotiq 2F-85 combined model, assembled by hand from:
      - model/universal_robots_ur5e/ur5e.xml  (BSD-3-Clause, MuJoCo Menagerie)
      - model/robotiq_2f85/2f85.xml           (BSD-2-Clause, MuJoCo Menagerie)
    Gripper is attached at the arm's attachment_site (wrist_3_link).
    Gripper default classes are prefixed "g_" to avoid collisions with the arm's.
    Scene: table + 3 graspable objects (cube/sphere/cylinder) + 2 place trays
           + 2 fixed cameras + 1 wrist camera.
    Gripper actuator "fingers_actuator": ctrl 0 = open, 255 = closed.
  -->
  <compiler angle="radian" meshdir="." autolimits="true"/>

  <option integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <map znear="0.005"/>
  </visual>

  <default>
    <default class="ur5e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <general gaintype="fixed" biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="2000" biasprm="0 -2000 -400"
        forcerange="-150 150"/>
      <default class="size3">
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size1">
        <general gainprm="500" biasprm="0 -500 -100" forcerange="-28 28"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <default class="2f85">
      <general biastype="affine"/>
      <joint axis="1 0 0"/>
      <default class="g_driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="g_follower">
        <joint range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065" solimplimit="0.95 0.99 0.001"
          solreflimit="0.005 1"/>
      </default>
      <default class="g_spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="g_coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="g_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="g_collision">
        <geom type="mesh" group="3"/>
        <default class="g_pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375" friction="0.7"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="g_pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375" friction="0.6"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="arm_black" rgba="0.033 0.033 0.033 1"/>
    <material name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material name="urblue" rgba="0.49 0.678 0.8 1"/>
    <material name="grip_black" rgba="0.149 0.149 0.149 1"/>
    <material name="grip_gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="table_mat" rgba="0.55 0.45 0.35 1"/>

    <!-- UR5e meshes -->
    <mesh file="universal_robots_ur5e/assets/base_0.obj"/>
    <mesh file="universal_robots_ur5e/assets/base_1.obj"/>
    <mesh file="universal_robots_ur5e/assets/shoulder_0.obj"/>
    <mesh file="universal_robots_ur5e/assets/shoulder_1.obj"/>
    <mesh file="universal_robots_ur5e/assets/shoulder_2.obj"/>
    <mesh file="universal_robots_ur5e/assets/upperarm_0.obj"/>
    <mesh file="universal_robots_ur5e/assets/upperarm_1.obj"/>
    <mesh file="universal_robots_ur5e/assets/upperarm_2.obj"/>
    <mesh file="universal_robots_ur5e/assets/upperarm_3.obj"/>
    <mesh file="universal_robots_ur5e/assets/forearm_0.obj"/>
    <mesh file="universal_robots_ur5e/assets/forearm_1.obj"/>
    <mesh file="universal_robots_ur5e/assets/forearm_2.obj"/>
    <mesh file="universal_robots_ur5e/assets/forearm_3.obj"/>
    <mesh file="universal_robots_ur5e/assets/wrist1_0.obj"/>
    <mesh file="universal_robots_ur5e/assets/wrist1_1.obj"/>
    <mesh file="universal_robots_ur5e/assets/wrist1_2.obj"/>
    <mesh file="universal_robots_ur5e/assets/wrist2_0.obj"/>
    <mesh file="universal_robots_ur5e/assets/wrist2_1.obj"/>
    <mesh file="universal_robots_ur5e/assets/wrist2_2.obj"/>
    <mesh file="universal_robots_ur5e/assets/wrist3.obj"/>

    <!-- 2F-85 meshes (STL in mm, scaled to m) -->
    <mesh name="g_base_mount" file="robotiq_2f85/assets/base_mount.stl" scale="0.001 0.001 0.001"/>
    <mesh name="g_base" file="robotiq_2f85/assets/base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="g_driver" file="robotiq_2f85/assets/driver.stl" scale="0.001 0.001 0.001"/>
    <mesh name="g_coupler" file="robotiq_2f85/assets/coupler.stl" scale="0.001 0.001 0.001"/>
    <mesh name="g_follower" file="robotiq_2f85/assets/follower.stl" scale="0.001 0.001 0.001"/>
    <mesh name="g_pad" file="robotiq_2f85/assets/pad.stl" scale="0.001 0.001 0.001"/>
    <mesh name="g_silicone_pad" file="robotiq_2f85/assets/silicone_pad.stl" scale="0.001 0.001 0.001"/>
    <mesh name="g_spring_link" file="robotiq_2f85/assets/spring_link.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="wrist_2_link" pos="0 -1 2"/>
    <light name="top" pos="0 0.45 2.5" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>

    <!-- ==================== UR5e arm ==================== -->
    <!-- arm is table-mounted (standard UR workstation): base sits on the 0.60
         table top, yawed 90 deg so the arm faces -x (toward the workspace) -->
    <body name="base" pos="0 0 0.60" quat="0.7071 0 0 -0.7071" childclass="ur5e">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom mesh="base_0" material="arm_black" class="visual"/>
      <geom mesh="base_1" material="jointgray" class="visual"/>
      <body name="shoulder_link" pos="0 0 0.163">
        <inertial mass="3.7" pos="0 0 0" diaginertia="0.0102675 0.0102675 0.00666"/>
        <joint name="shoulder_pan_joint" class="size3" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="urblue" class="visual"/>
        <geom mesh="shoulder_1" material="arm_black" class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>
        <geom class="collision" size="0.06 0.06" pos="0 0 -0.04"/>
        <body name="upper_arm_link" pos="0 0.138 0" quat="1 0 1 0">
          <inertial mass="8.393" pos="0 0 0.2125" diaginertia="0.133886 0.133886 0.0151074"/>
          <joint name="shoulder_lift_joint" class="size3"/>
          <geom mesh="upperarm_0" material="linkgray" class="visual"/>
          <geom mesh="upperarm_1" material="arm_black" class="visual"/>
          <geom mesh="upperarm_2" material="jointgray" class="visual"/>
          <geom mesh="upperarm_3" material="urblue" class="visual"/>
          <geom class="collision" pos="0 -0.04 0" quat="1 1 0 0" size="0.06 0.06"/>
          <geom class="collision" size="0.05 0.2" pos="0 0 0.2"/>
          <body name="forearm_link" pos="0 -0.131 0.425">
            <inertial mass="2.275" pos="0 0.196 0" diaginertia="0.0311796 0.0311796 0.004095"/>
            <joint name="elbow_joint" class="size3_limited"/>
            <geom mesh="forearm_0" material="urblue" class="visual"/>
            <geom mesh="forearm_1" material="linkgray" class="visual"/>
            <geom mesh="forearm_2" material="arm_black" class="visual"/>
            <geom mesh="forearm_3" material="jointgray" class="visual"/>
            <geom class="collision" pos="0 0.08 0" quat="1 1 0 0" size="0.055 0.06"/>
            <geom class="collision" size="0.038 0.19" pos="0 0 0.2"/>
            <body name="wrist_1_link" pos="0 0 0.392" quat="1 0 1 0">
              <inertial mass="1.219" pos="0 0.127 0" diaginertia="0.0025599 0.0025599 0.0021942"/>
              <joint name="wrist_1_joint" class="size1"/>
              <geom mesh="wrist1_0" material="arm_black" class="visual"/>
              <geom mesh="wrist1_1" material="urblue" class="visual"/>
              <geom mesh="wrist1_2" material="jointgray" class="visual"/>
              <geom class="collision" pos="0 0.05 0" quat="1 1 0 0" size="0.04 0.07"/>
              <body name="wrist_2_link" pos="0 0.127 0">
                <inertial mass="1.219" pos="0 0.1 0" diaginertia="0.0025599 0.0025599 0.0021942"/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size1"/>
                <geom mesh="wrist2_0" material="arm_black" class="visual"/>
                <geom mesh="wrist2_1" material="urblue" class="visual"/>
                <geom mesh="wrist2_2" material="jointgray" class="visual"/>
                <geom class="collision" size="0.04 0.06" pos="0 0 0.04"/>
                <geom class="collision" pos="0 0.02 0.1" quat="1 1 0 0" size="0.04 0.04"/>
                <body name="wrist_3_link" pos="0 0 0.1">
                  <inertial mass="0.1889" pos="0 0.0771683 0" quat="1 0 0 1"
                    diaginertia="0.000132134 9.90863e-05 9.90863e-05"/>
                  <joint name="wrist_3_joint" class="size1"/>
                  <geom material="linkgray" mesh="wrist3" class="visual"/>
                  <geom class="eef_collision" pos="0 0.08 0" quat="1 1 0 0" size="0.04 0.02"/>
                  <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/>

                  <!-- ==================== Robotiq 2F-85 ==================== -->
                  <body name="base_mount" pos="0 0.1 0" quat="-1 1 0 0">
                    <body name="2f85_base_body" pos="0 0 0.007" childclass="2f85">
                      <geom class="g_visual" mesh="g_base_mount" material="grip_black"/>
                      <geom class="g_collision" mesh="g_base_mount"/>
                      <body name="gripper_base" pos="0 0 0.0038" quat="1 0 0 -1">
                        <inertial mass="0.777441" pos="0 -2.70394e-05 0.0354675" quat="1 -0.00152849 0 0"
                          diaginertia="0.000260285 0.000225381 0.000152708"/>
                        <geom class="g_visual" mesh="g_base" material="grip_black"/>
                        <geom class="g_collision" mesh="g_base"/>
                        <site name="pinch" pos="0 0 0.145" type="sphere" group="5" rgba="0.9 0.9 0.9 1" size="0.005"/>
                        <!-- wrist camera: looks along gripper +z (toward fingertips) -->
                        <camera name="wrist_cam" pos="0 0.045 0.06" fovy="58" xyaxes="-1 0 0 0 1 0"/>
                        <!-- Right-hand side 4-bar linkage -->
                        <body name="right_driver" pos="0 0.0306011 0.054904">
                          <inertial mass="0.00899563" pos="2.96931e-12 0.0177547 0.00107314" quat="0.681301 0.732003 0 0"
                            diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                          <joint name="right_driver_joint" class="g_driver"/>
                          <geom class="g_visual" mesh="g_driver" material="grip_gray"/>
                          <geom class="g_collision" mesh="g_driver"/>
                          <body name="right_coupler" pos="0 0.0315 -0.0041">
                            <inertial mass="0.0140974" pos="0 0.00301209 0.0232175" quat="0.705636 -0.0455904 0.0455904 0.705636"
                              diaginertia="4.16206e-06 3.52216e-06 8.8831e-07"/>
                            <joint name="right_coupler_joint" class="g_coupler"/>
                            <geom class="g_visual" mesh="g_coupler" material="grip_black"/>
                            <geom class="g_collision" mesh="g_coupler"/>
                          </body>
                        </body>
                        <body name="right_spring_link" pos="0 0.0132 0.0609">
                          <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658" quat="0.663403 -0.244737 0.244737 0.663403"
                            diaginertia="8.96853e-06 6.71726e-06 2.63931e-06"/>
                          <joint name="right_spring_link_joint" class="g_spring_link"/>
                          <geom class="g_visual" mesh="g_spring_link" material="grip_black"/>
                          <geom class="g_collision" mesh="g_spring_link"/>
                          <body name="right_follower" pos="0 0.055 0.0375">
                            <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0"
                              diaginertia="2.67428e-06 2.45508e-06 6.02031e-07"/>
                            <joint name="right_follower_joint" class="g_follower"/>
                            <geom class="g_visual" mesh="g_follower" material="grip_black"/>
                            <geom class="g_collision" mesh="g_follower"/>
                            <body name="right_pad" pos="0 -0.0189 0.01352">
                              <geom class="g_pad_box1" name="right_pad1"/>
                              <geom class="g_pad_box2" name="right_pad2"/>
                              <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="0.707107 0 0 0.707107"
                                diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                              <geom class="g_visual" mesh="g_pad"/>
                              <body name="right_silicone_pad">
                                <geom class="g_visual" mesh="g_silicone_pad" material="grip_black"/>
                              </body>
                            </body>
                          </body>
                        </body>
                        <!-- Left-hand side 4-bar linkage -->
                        <body name="left_driver" pos="0 -0.0306011 0.054904" quat="0 0 0 1">
                          <inertial mass="0.00899563" pos="0 0.0177547 0.00107314" quat="0.681301 0.732003 0 0"
                            diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                          <joint name="left_driver_joint" class="g_driver"/>
                          <geom class="g_visual" mesh="g_driver" material="grip_gray"/>
                          <geom class="g_collision" mesh="g_driver"/>
                          <body name="left_coupler" pos="0 0.0315 -0.0041">
                            <inertial mass="0.0140974" pos="0 0.00301209 0.0232175" quat="0.705636 -0.0455904 0.0455904 0.705636"
                              diaginertia="4.16206e-06 3.52216e-06 8.8831e-07"/>
                            <joint name="left_coupler_joint" class="g_coupler"/>
                            <geom class="g_visual" mesh="g_coupler" material="grip_black"/>
                            <geom class="g_collision" mesh="g_coupler"/>
                          </body>
                        </body>
                        <body name="left_spring_link" pos="0 -0.0132 0.0609" quat="0 0 0 1">
                          <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658" quat="0.663403 -0.244737 0.244737 0.663403"
                            diaginertia="8.96853e-06 6.71726e-06 2.63931e-06"/>
                          <joint name="left_spring_link_joint" class="g_spring_link"/>
                          <geom class="g_visual" mesh="g_spring_link" material="grip_black"/>
                          <geom class="g_collision" mesh="g_spring_link"/>
                          <body name="left_follower" pos="0 0.055 0.0375">
                            <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0"
                              diaginertia="2.67428e-06 2.45508e-06 6.02031e-07"/>
                            <joint name="left_follower_joint" class="g_follower"/>
                            <geom class="g_visual" mesh="g_follower" material="grip_black"/>
                            <geom class="g_collision" mesh="g_follower"/>
                            <body name="left_pad" pos="0 -0.0189 0.01352">
                              <geom class="g_pad_box1" name="left_pad1"/>
                              <geom class="g_pad_box2" name="left_pad2"/>
                              <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="1 0 0 1"
                                diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                              <geom class="g_visual" mesh="g_pad"/>
                              <body name="left_silicone_pad">
                                <geom class="g_visual" mesh="g_silicone_pad" material="grip_black"/>
                              </body>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ==================== Scene ==================== -->
    <geom name="floor" type="plane" size="2.5 2.5 0.1" rgba="0.3 0.3 0.35 1"/>

    <!-- table: top surface at z=0.60, x in [-0.90, 0.30], y in [-0.45, 0.45];
         the robot base sits on it at the origin, workspace extends in front (-x) -->
    <body name="table" pos="-0.30 0 0">
      <geom name="table_top" type="box" size="0.60 0.45 0.02" pos="0 0 0.58" material="table_mat"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="table_leg1" type="box" size="0.035 0.035 0.28" pos="0.55 0.40 0.28" material="table_mat"/>
      <geom name="table_leg2" type="box" size="0.035 0.035 0.28" pos="-0.55 0.40 0.28" material="table_mat"/>
      <geom name="table_leg3" type="box" size="0.035 0.035 0.28" pos="0.55 -0.40 0.28" material="table_mat"/>
      <geom name="table_leg4" type="box" size="0.035 0.035 0.28" pos="-0.55 -0.40 0.28" material="table_mat"/>
    </body>

    <!-- graspable objects: 5 cm cube, 4.4 cm sphere, d44x60 mm cylinder;
         poses and colors randomized per episode by the collector -->
    <body name="cube" pos="-0.55 0.05 0.635">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.05" rgba="0.8 0.2 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
    </body>
    <body name="sphere" pos="-0.45 0.10 0.623">
      <freejoint name="sphere_joint"/>
      <!-- higher rolling friction (3rd coef): spheres otherwise spin forever
           on release and never pass the "at rest" success check -->
      <geom name="sphere_geom" type="sphere" size="0.022" mass="0.04" rgba="0.2 0.8 0.2 1"
        friction="1 0.02 0.01" condim="4"/>
    </body>
    <body name="cylinder" pos="-0.65 0.00 0.631">
      <freejoint name="cylinder_joint"/>
      <geom name="cylinder_geom" type="cylinder" size="0.022 0.03" mass="0.06" rgba="0.2 0.2 0.8 1"
        friction="1 0.005 0.0001" condim="4"/>
    </body>

    <!-- two place-target trays (7.4 cm footprint, 2 cm walls), static bodies:
         colors and xy positions set at runtime; tray floor top sits at 0.606 -->
    <body name="container_a" pos="-0.45 -0.12 0.60">
      <geom name="cont_a_base" type="box" size="0.07 0.07 0.003" pos="0 0 0.003" rgba="0.2 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_a_wall_n" type="box" size="0.074 0.004 0.013" pos="0 0.070 0.016" rgba="0.2 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_a_wall_s" type="box" size="0.074 0.004 0.013" pos="0 -0.070 0.016" rgba="0.2 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_a_wall_e" type="box" size="0.004 0.074 0.013" pos="0.070 0 0.016" rgba="0.2 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_a_wall_w" type="box" size="0.004 0.074 0.013" pos="-0.070 0 0.016" rgba="0.2 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
    </body>
    <body name="container_b" pos="-0.45 0.12 0.60">
      <geom name="cont_b_base" type="box" size="0.07 0.07 0.003" pos="0 0 0.003" rgba="0.9 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_b_wall_n" type="box" size="0.074 0.004 0.013" pos="0 0.070 0.016" rgba="0.9 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_b_wall_s" type="box" size="0.074 0.004 0.013" pos="0 -0.070 0.016" rgba="0.9 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_b_wall_e" type="box" size="0.004 0.074 0.013" pos="0.070 0 0.016" rgba="0.9 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
      <geom name="cont_b_wall_w" type="box" size="0.004 0.074 0.013" pos="-0.070 0 0.016" rgba="0.9 0.9 0.2 1"
        friction="1 0.005 0.0001" condim="4"/>
    </body>

    <!-- teleop goal marker: shows where the IK target is; alpha is zeroed while
         recording camera frames so it never appears in the collected images -->
    <site name="tcp_goal" type="sphere" size="0.016" pos="0 0 1" rgba="0.2 0.9 0.2 0.45"/>

    <!-- third-person cameras (static), aimed at the workspace in front of the arm -->
    <camera name="front_cam" pos="-0.45 -0.95 1.25" fovy="50" xyaxes="0.9987 0.0531 0 -0.0266 0.5004 0.8653"/>
    <camera name="side_cam" pos="-0.25 1.15 1.30" fovy="50" xyaxes="-0.9962 0.0866 0 -0.0368 -0.4231 0.8913"/>
  </worldbody>

  <contact>
    <exclude body1="gripper_base" body2="left_driver"/>
    <exclude body1="gripper_base" body2="right_driver"/>
    <exclude body1="gripper_base" body2="left_spring_link"/>
    <exclude body1="gripper_base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
