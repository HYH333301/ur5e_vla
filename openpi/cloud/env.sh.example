# Template of /root/shared-nvme/code/env.sh on the paratera container.
# Copy to the cloud and fill in the real HF_TOKEN (kept in local .env).
export HF_ENDPOINT=https://hf-mirror.com
export HF_TOKEN=<HF_TOKEN>
export HF_LEROBOT_HOME=/root/shared-nvme/hf_data/lerobot
export UV_CACHE_DIR=/root/shared-nvme/.uv-cache
export UV_PYTHON_INSTALL_DIR=/root/shared-nvme/.uv-python
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/root/shared-nvme/hf_data/hub
export OPENPI_DATA_HOME=/root/shared-nvme/openpi_cache
